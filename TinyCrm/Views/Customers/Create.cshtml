@model TinyCrm.Models.Customer
@{
    ViewBag.Title = "New customer";
}

<div class="card">
    <h2>New customer</h2>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

        <div class="form-grid">
            <div class="field">
                @Html.LabelFor(m => m.Name)
                @Html.TextBoxFor(m => m.Name)
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Company)
                @Html.TextBoxFor(m => m.Company)
                @Html.ValidationMessageFor(m => m.Company, "", new { @class = "field-error" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email)
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Phone)
                @Html.TextBoxFor(m => m.Phone)
                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "field-error" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Status)
                @Html.DropDownListFor(m => m.Status, new SelectList(Enum.GetValues(typeof(TinyCrm.Models.CustomerStatus))))
                @Html.ValidationMessageFor(m => m.Status, "", new { @class = "field-error" })
            </div>

            <div class="field full">
                @Html.LabelFor(m => m.Notes)
                @Html.TextAreaFor(m => m.Notes)
                @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "field-error" })
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
        </div>
    }
</div>