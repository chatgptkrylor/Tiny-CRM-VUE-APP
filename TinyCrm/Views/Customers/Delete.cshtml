@model TinyCrm.Models.Customer
@{
    ViewBag.Title = "Delete customer";
}

<div class="card">
    <h2>Delete customer</h2>
    <p>Are you sure you want to delete <strong>@Model.Name</strong>? This will also delete all of their interactions.</p>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <div class="actions">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
        </div>
    }
</div>