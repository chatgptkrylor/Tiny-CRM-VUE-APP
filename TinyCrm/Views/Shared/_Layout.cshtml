@{
    var isAuth = Session != null && Session["Username"] != null;
    var displayName = Session != null && Session["DisplayName"] != null ? (string)Session["DisplayName"] : "";
    var current = (string)ViewContext.RouteData.Values["controller"];
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Tiny CRM</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <div class="brand"><a href="@Url.Action("Index","Dashboard")">Tiny CRM</a></div>
            @if (isAuth)
            {
                <nav class="nav">
                    <a href="@Url.Action("Index","Dashboard")" class="@(current=="Dashboard"?"active":"")">Dashboard</a>
                    <a href="@Url.Action("Index","Customers")" class="@(current=="Customers"?"active":"")">Customers</a>
                    <a href="@Url.Action("Index","Reports")" class="@(current=="Reports"?"active":"")">Reports</a>
                </nav>
                <div class="user-menu">
                    <span class="user-name">@displayName</span>
                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "logout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link">Sign out</button>
                    }
                </div>
            }
        </div>
    </header>

    <main class="container">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">Tiny CRM &mdash; ASP.NET MVC 5 / .NET Framework 4.7.2</div>
    </footer>
</body>
</html>