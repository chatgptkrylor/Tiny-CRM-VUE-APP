@model TinyCrm.Models.Interaction

@{
    ViewBag.Title = "Log interaction";
}

<div class="page-header">
    <h1>Log interaction</h1>
    @if (ViewBag.CustomerName != null)
    {
        <a href="@Url.Action("Details", "Customers", new { id = Model.CustomerId })" class="btn btn-secondary">Back to customer</a>
    }
</div>

<div class="card">
    <h2>@(ViewBag.CustomerName != null ? "For " + (string)ViewBag.CustomerName : "New interaction")</h2>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form" }))
    {
        @Html.AntiForgeryToken();
        @Html.ValidationSummary(true);
        @Html.HiddenFor(m => m.CustomerId);

        <div class="form-grid">
            <div class="field">
                @Html.LabelFor(m => m.Type)
                @Html.DropDownListFor(m => m.Type, new SelectList(Enum.GetValues(typeof(TinyCrm.Models.InteractionType))))
                @Html.ValidationMessageFor(m => m.Type)
            </div>

            <div class="field">
                @Html.LabelFor(m => m.InteractionDate)
                @Html.TextBoxFor(m => m.InteractionDate, "{0:yyyy-MM-dd}", new { type = "date" })
                @Html.ValidationMessageFor(m => m.InteractionDate)
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Subject)
                @Html.TextBoxFor(m => m.Subject)
                @Html.ValidationMessageFor(m => m.Subject)
            </div>

            <div class="field full">
                @Html.LabelFor(m => m.Notes)
                @Html.TextAreaFor(m => m.Notes)
                @Html.ValidationMessageFor(m => m.Notes)
            </div>
        </div>

        <div class="field">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@Url.Action("Details", "Customers", new { id = Model.CustomerId })" class="btn btn-secondary">Cancel</a>
        </div>
    }
</div>