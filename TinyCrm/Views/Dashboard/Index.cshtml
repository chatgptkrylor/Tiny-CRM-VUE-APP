@using TinyCrm.Models
@model TinyCrm.Models.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalForBars = Model.TotalCustomers == 0 ? 1 : Model.TotalCustomers;
    var totalInteractionsForBars = Model.TotalInteractions == 0 ? 1 : Model.TotalInteractions;
}

<div class="page-header">
    <h1>Dashboard</h1>
    <div class="actions">
        <a href="@Url.Action("Create", "Customers")" class="btn btn-primary">New customer</a>
    </div>
</div>

<div class="grid">
    <div class="stat">
        <div class="label">Total customers</div>
        <div class="value">@Model.TotalCustomers</div>
    </div>
    <div class="stat">
        <div class="label">Total interactions</div>
        <div class="value">@Model.TotalInteractions</div>
    </div>
    <div class="stat">
        <div class="label">Needs follow-up</div>
        <div class="value">@Model.NeedsFollowUps</div>
    </div>
</div>

<div class="card">
    <h2>Customers by status</h2>
    @foreach (CustomerStatus status in Enum.GetValues(typeof(CustomerStatus)))
    {
        var count = Model.CustomersByStatus.ContainsKey(status) ? Model.CustomersByStatus[status] : 0;
        var pct = (int)(count * 100 / totalForBars);
        <div class="bar-row">
            <div class="bar-label">@status.ToString()</div>
            <div class="bar-track"><div class="bar-fill" style="width:@(pct)%"></div></div>
            <div class="bar-value">@count</div>
        </div>
    }
</div>

<div class="card">
    <h2>Interactions by type</h2>
    @foreach (InteractionType type in Enum.GetValues(typeof(InteractionType)))
    {
        var count = Model.InteractionsByType.ContainsKey(type) ? Model.InteractionsByType[type] : 0;
        var pct = (int)(count * 100 / totalInteractionsForBars);
        <div class="bar-row">
            <div class="bar-label">@type.ToString()</div>
            <div class="bar-track"><div class="bar-fill" style="width:@(pct)%"></div></div>
            <div class="bar-value">@count</div>
        </div>
    }
</div>

<div class="card">
    <h2>Recent interactions</h2>
    @if (Model.RecentInteractions == null || !Model.RecentInteractions.Any())
    {
        <div class="empty">No interactions yet.</div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Customer</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.RecentInteractions)
                {
                    <tr>
                        <td>@i.InteractionDate.ToString("yyyy-MM-dd")</td>
                        <td>@i.Type.ToString()</td>
                        <td>@i.Subject</td>
                        <td><a href="@Url.Action("Details", "Customers", new { id = i.CustomerId })">@i.CustomerName</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>